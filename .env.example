# BigFix root server. Hostname or full URL. Port defaults to 52311.
# https://developer.bigfix.com/rest-api/
BIGFIX_URL=https://bigfix.example.com:52311

# Console operator that can see the computers to export.
# A Master Operator sees every computer. A non-master operator only sees
# the computers that operator administers.
BIGFIX_USERNAME=inventory-operator
BIGFIX_PASSWORD=replace-me

# Coralogix Send-Your-Data key. Keep this in a secret store, not in git.
# Domain is the hostname after ".app." in the console URL, with no https://
# and no ingress. prefix.
#   US1: coralogix.com          EU2: eu2.coralogix.com
#   India (AP1): coralogix.in   US2: us2.coralogix.com
CORALOGIX_PRIVATE_KEY=replace-me
CORALOGIX_DOMAIN=coralogix.com

# Labels. A renamed label starts a new history in Coralogix.
CX_APPLICATION_NAME=bigfix
CX_SUBSYSTEM_NAME=inventory

# Optional
# BIGFIX_PROFILE=full          # full | basic
# BIGFIX_COMPUTER_GROUP=       # only members of this computer group
# BIGFIX_VERIFY_SSL=true       # false when the root server uses a private CA
# BIGFIX_CA_BUNDLE=            # path to a PEM bundle; overrides BIGFIX_VERIFY_SSL
# BIGFIX_TIMEOUT_SECONDS=600
# BIGFIX_STALE_DAYS=7          # last report older than this is severity Warning
# CORALOGIX_BATCH_SIZE=50
# DEBUG=false
